#!/usr/bin/env python3
"""Entry point: ./markets <command>. See ./markets --help."""
import sys
from pathlib import Path

if sys.version_info < (3, 10):
    sys.exit("Markets needs Python 3.10+ (use /opt/homebrew/bin/python3)")

sys.path.insert(0, str(Path(__file__).resolve().parent / "backend"))

from markets.cli import main  # noqa: E402

sys.exit(main())
